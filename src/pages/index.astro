---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import AboutSection from '@/components/AboutSection.astro';
import ServicesTable from '@/components/ServicesTable.astro';
import CoreCompetencies from '@/components/CoreCompetencies.astro';
import BrandsSection from '@/components/BrandsSection.astro';
import BenefitsSection from '@/components/BenefitsSection.astro';
import TestimonialsSection from '@/components/TestimonialsSection.astro';
import CoverageSection from '@/components/CoverageSection.astro';
import ContactSection from '@/components/ContactSection.astro';
import Footer from '@/components/Footer.astro';
---

<Layout
  title="Parody Mechanical Solutions"
  description="Diesel mechanics, electrical and hydraulic diagnostics for commercial fleets and heavy equipment in Tooele, Salt Lake City and across Utah. On-site field and roadside service. SAM.gov registered."
  businessSchema
>
  <Header />
  <main>
    <Hero />
    <AboutSection />
    <CoreCompetencies />
    <BrandsSection />
    <ServicesTable />
    <BenefitsSection />
    <TestimonialsSection />
    <CoverageSection />
    <ContactSection />
  </main>
  <Footer />
