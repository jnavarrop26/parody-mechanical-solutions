---
import DetailPage from '@/components/DetailPage.astro';
import en from '@/data/en/CoreCompetencies.json';
import es from '@/data/es/CoreCompetencies.json';
import { pairEntries, altPaths, servicePageSchema } from '@/lib/detail-paths';

export function getStaticPaths() {
  return pairEntries(en.items, es.items).map((pair) => ({
    params: { slug: pair.es.slug },
    props: { item: pair.es, alternates: altPaths({ en: 'competencies', es: 'competencias' }, { en: pair.en.slug, es: pair.es.slug }) },
  }));
}

const { item, alternates } = Astro.props;

const schema = servicePageSchema({
  site: Astro.site,
  name: item.name,
  description: item.longDesc,
  path: alternates.es,
  sectionLabel: 'Especialidades',
  sectionPath: '/es/#competencies',
  homePath: '/es/',
});
---

<DetailPage
  pageTitle={`${item.name} — Mecánicos en Utah`}
  pageDesc={item.longDesc}
  kicker="Especialidades"
  backHref="/es/#competencies"
  title={item.name}
  intro={item.longDesc}
  paragraphs={item.paragraphs}
  signals={item.signals}
  itemsLabel="Alcance"
  items={item.sub}
  alternates={alternates}
  schema={schema}
/>
