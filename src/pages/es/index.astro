---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import AboutSection from '@/components/AboutSection.astro';
import ServicesTable from '@/components/ServicesTable.astro';
import CoreCompetencies from '@/components/CoreCompetencies.astro';
import BrandsSection from '@/components/BrandsSection.astro';
import BenefitsSection from '@/components/BenefitsSection.astro';
import CoverageSection from '@/components/CoverageSection.astro';
import ContactSection from '@/components/ContactSection.astro';
import Footer from '@/components/Footer.astro';
---

{/* El título abre con la consulta que se busca, no con la marca: en un
   resultado, "Mecánicos en Utah" gana la mirada antes que un nombre propio
   que todavía nadie conoce. La razón social va al final, que es donde la
   necesita quien ya llegó por marca. */}
<Layout
  title="Parody Mechanical Solutions"
  description="Mecánica diésel, diagnóstico eléctrico e hidráulico para flotas y maquinaria pesada en Tooele, Salt Lake City y todo Utah. Servicio a domicilio y asistencia en carretera. Cotiza en un día hábil."
  businessSchema
>
  <Header />
  <main>
    <Hero />
    <AboutSection />
    <CoreCompetencies />
    <BrandsSection />
    <ServicesTable />
    <BenefitsSection />
    <CoverageSection />
    <ContactSection />
  </main>
  <Footer />
</Layout>
