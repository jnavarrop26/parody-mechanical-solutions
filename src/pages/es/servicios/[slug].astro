---
import DetailPage from '@/components/DetailPage.astro';
import en from '@/data/en/ServicesTable.json';
import es from '@/data/es/ServicesTable.json';
import { pairEntries, altPaths, servicePageSchema } from '@/lib/detail-paths';

export function getStaticPaths() {
  return pairEntries(en.categories, es.categories).map((pair) => ({
    params: { slug: pair.es.slug },
    props: { item: pair.es, alternates: altPaths({ en: 'services', es: 'servicios' }, { en: pair.en.slug, es: pair.es.slug }) },
  }));
}

const { item, alternates } = Astro.props;

const schema = servicePageSchema({
  site: Astro.site,
  name: item.name,
  description: item.longDesc,
  path: alternates.es,
  sectionLabel: 'Servicios',
  sectionPath: '/es/#services',
  homePath: '/es/',
});
---

<DetailPage
  pageTitle={`${item.name} — Mecánica Diésel y Flotas en Utah`}
  pageDesc={item.longDesc}
  kicker="Servicios"
  backHref="/es/#services"
  title={item.name}
  stamp={item.mode}
  intro={item.longDesc}
  itemsLabel="Qué incluye"
  items={item.items}
  alternates={alternates}
  schema={schema}
/>
