---
import DetailPage from '@/components/DetailPage.astro';
import en from '@/data/en/CoreCompetencies.json';
import es from '@/data/es/CoreCompetencies.json';
import { pairEntries, altPaths, servicePageSchema } from '@/lib/detail-paths';

export function getStaticPaths() {
  return pairEntries(en.items, es.items).map((pair) => ({
    params: { slug: pair.en.slug },
    props: { item: pair.en, alternates: altPaths({ en: 'competencies', es: 'competencias' }, { en: pair.en.slug, es: pair.es.slug }) },
  }));
}

const { item, alternates } = Astro.props;

const schema = servicePageSchema({
  site: Astro.site,
  name: item.name,
  description: item.longDesc,
  path: alternates.en,
  sectionLabel: 'Competencies',
  sectionPath: '/#competencies',
  homePath: '/',
});
---

<DetailPage
  pageTitle={`${item.name} — Parody Mechanical Solutions LLC`}
  pageDesc={item.longDesc}
  kicker="Competencies"
  backHref="/#competencies"
  title={item.name}
  intro={item.longDesc}
  paragraphs={item.paragraphs}
  signals={item.signals}
  itemsLabel="Scope"
  items={item.sub}
  alternates={alternates}
  schema={schema}
/>
