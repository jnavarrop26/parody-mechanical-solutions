---
import { content } from '@/i18n/content';
import { ui } from '@/i18n/ui';
import { defaultLocale, localeMeta, locales, localizePath, toLocale, type Locale } from '@/i18n/config';

interface Props {
  /* Rutas equivalentes por idioma para el switcher. Solo hace falta pasarlas
     cuando los slugs difieren entre idiomas (páginas de detalle); si se
     omite, se derivan del path actual igual que en Layout.astro. */
  alternates?: Partial<Record<Locale, string>>;
}

const { alternates } = Astro.props;

const data = content<any>('Header', Astro.currentLocale);

const { mark, menuLabel, links } = data;

/* El emblema vuelve a la home del idioma que se está leyendo, no siempre a la inglesa */
const locale = toLocale(Astro.currentLocale);

/* Misma derivación que Layout.astro: el path sin el prefijo de idioma, para
   poder ofrecer el equivalente en el otro idioma cuando la página no pasa
   alternates explícitos (home, 404). */
const basePath =
  locale === defaultLocale
    ? Astro.url.pathname
    : Astro.url.pathname.replace(new RegExp(`^/${locale}`), '') || '/';

const langLinks = locales.map((l) => ({
  code: l,
  label: localeMeta[l].label,
  hreflang: localeMeta[l].hreflang,
  href: alternates?.[l] ?? localizePath(l, basePath),
  current: l === locale,
}));

/* El lockup se arma desde `mark.sub`, no con dos campos en el JSON: la
   primera palabra es el nombre y el resto la especialidad, que es como se
   pinta en la puerta de un camión de taller. Si algún día la razón social
   cambia, sigue siendo un solo string el que manda. */
const [markName, ...markRest] = mark.sub.split(' ');
const markDescriptor = markRest.join(' ');
---

<header class="header">
  {/* Sin .wrap a propósito: la banda es una placa pintada de borde a borde,
     así que el lockup se apoya en el filo izquierdo y la nav en el derecho,
     con el gutter como único margen. Con .wrap (max 1400px) en un monitor
     ancho ambos quedaban flotando hacia el centro */}
  <div class="header__row">
    <a href={localizePath(locale, '/')} class="mark">
      {/* Ruta absoluta: `./public/…` se resolvía contra la URL de la página
         (404 en la home y en cada subpágina) y public/ se copia a la raíz.
         Las medidas son las del viewBox del SVG, que es cuadrado — con las
         de logo.webp (871×1080) el hueco reservado quedaba angosto.

         alt vacío a propósito: el nombre ya va escrito al lado, y con alt
         el enlace a la home se anunciaría dos veces la misma razón social */}
      <img class="mark__logo" src="/favicon.svg" alt="" width="169" height="169" />
      <span class="mark__lockup">
        <span class="mark__name">{markName}</span>
        <span class="mark__descriptor">{markDescriptor}</span>
      </span>
    </a>

    <button
      class="header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-menu"
    >
      <span class="header__toggle-icon" aria-hidden="true">
        <img class="header__toggle-open" src="/icon/menu.svg" alt="" />
        <img class="header__toggle-close" src="/icon/x-menu.svg" alt="" />
      </span>
      <span class="header__toggle-label">{menuLabel}</span>
    </button>

    <nav id="main-menu" class="header__nav" aria-label={ui('navLabel', Astro.currentLocale)}>
      <ul>
        {
          links.map((link, i) => (
            <li class:list={['nav__item', link.children && 'nav__item--sub']}>
              <div class="nav__item-row">
                <a href={link.href}>{link.label}</a>
                {link.children && (
                  <button
                    type="button"
                    class="nav__caret-btn"
                    aria-expanded="false"
                    aria-controls={`nav-sub-${i}`}
                    aria-label={`${ui('toggleSubmenu', Astro.currentLocale)}: ${link.label}`}
                  >
                    <span class="nav__caret" aria-hidden="true">
                      ▾
                    </span>
                  </button>
                )}
              </div>
              {link.children && (
                <div class="nav__sub-wrap" id={`nav-sub-${i}`}>
                  <ul class="nav__sub">
                    {link.children.map((child) => (
                      <li>
                        <a href={child.href}>{child.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
        <li class="nav__item nav__item--lang">
          {/* La etiqueta solo se ve en el panel móvil (ver CSS): en la barra
             de escritorio el propio EN/ES ya se explica solo y un texto al
             lado sería ruido junto a seis links de una palabra */}
          <span class="nav__lang-label" aria-hidden="true">{ui('languageLabel', Astro.currentLocale)}</span>
          <div class="lang-switch" role="group" aria-label={ui('languageLabel', Astro.currentLocale)}>
            {
              langLinks.map((l) =>
                l.current ? (
                  <span class="lang-switch__opt is-current" aria-current="true" lang={l.code}>
                    {l.code.toUpperCase()}
                  </span>
                ) : (
                  <a class="lang-switch__opt" href={l.href} hreflang={l.hreflang} lang={l.code} title={l.label}>
                    {l.code.toUpperCase()}
                  </a>
                )
              )
            }
          </div>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.header');
  const toggle = document.querySelector('.header__toggle');
  const nav = document.querySelector('.header__nav');

  if (header && toggle && nav) {
    const subItems = Array.from(nav.querySelectorAll<HTMLElement>('.nav__item--sub'));
    const caretButtons = Array.from(nav.querySelectorAll<HTMLButtonElement>('.nav__caret-btn'));

    const closeSubmenus = () => {
      for (const item of subItems) item.removeAttribute('data-open');
      for (const btn of caretButtons) btn.setAttribute('aria-expanded', 'false');
    };

    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      /* Al cerrar el panel entero se resetean los submenús: si no, la
         próxima vez que se abra el hamburguesa aparece con los que se
         habían dejado abiertos la vez anterior */
      if (!open) closeSubmenus();
    };

    toggle.addEventListener('click', () => {
      setOpen(!header.classList.contains('is-open'));
    });

    for (const btn of caretButtons) {
      btn.addEventListener('click', () => {
        const item = btn.closest<HTMLElement>('.nav__item--sub');
        if (!item) return;
        const isOpen = item.hasAttribute('data-open');
        item.toggleAttribute('data-open', !isOpen);
        btn.setAttribute('aria-expanded', String(!isOpen));
      });
    }

    /* Los enlaces son anclas de la misma página: al elegir una, el menú se cierra.
       .nav__caret-btn no es <a>, así que closest('a') no lo agarra y solo
       despliega/colapsa su propio submenú sin cerrar el panel entero */
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        (toggle as HTMLElement).focus();
      }
    });
  }
</script>

<style>
  /* Banda roja de marca, opaca y con filo duro: el mismo borde de 2px en
     tinta que llevan las cards, el dropdown y el panel móvil, para que se
     lea como placa pintada y no como navbar genérica.

     Sin backdrop-filter a propósito: a este nivel de opacidad el rojo no
     deja ver nada detrás, y al ser sticky se le nota el cambio de tono
     según si pasa sobre el hero oscuro o sobre una sección clara.

     Sobre este rojo solo --paper pasa AA para texto chico (5.42:1);
     --chrome se queda en 4.11:1 y la tinta oscura en 3.00:1. Por eso todo
     lo que va encima de la barra es --paper. */
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--rust);
    border-bottom: 2px solid var(--ink);
  }

  /* El foco global es --enamel (2.39:1 sobre el rojo, no llega al 3:1 que
     pide WCAG para indicadores); sobre la barra se invierte a papel */
  .header :focus-visible {
    outline-color: var(--paper);
  }

  .header__row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    /* El mismo gutter que usa .wrap, pero aplicado a un bloque de ancho
       completo: los extremos quedan a la misma distancia del filo que el
       resto del sitio, sin el tope de 1400px que los recogía al centro */
    padding-inline: var(--gutter);
    /* El aire vertical lo fija el emblema (40px), la pieza más alta; el
       padding solo lo despega del filo. Total ~69px */
    padding-block: 0.85rem;
  }

  /* Emblema y tipografía separados por un filete de papel: el logo deja de
     ser un icono pegado al texto y el conjunto se lee como una calcomanía
     de puerta de camión, con la marca a un lado de la línea y el oficio al
     otro. Es el único adorno del lockup */
  .mark {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--paper);
  }

  /* El emblema completo es ilegible por debajo de ~64px (probado al generar
     el favicon); a esta altura se reconoce como marca aunque el texto
     interno no se lea — de eso se encarga ahora el lockup de al lado.

     Va con sus colores de origen (contorno carbón, relleno blanco). El
     carbón sobre el rojo da 3.8:1: suficiente para un gráfico, y los
     rellenos blancos son los que arman la silueta a este tamaño. */
  .mark__logo {
    height: 40px;
    width: auto;
  }

  /* El filete se recorta a la altura del emblema en vez de crecer con la
     barra: es un separador de lockup, no un divisor de la banda */
  .mark__lockup {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    padding-left: 0.65rem;
    border-left: 1px solid color-mix(in srgb, var(--paper) 45%, transparent);
  }

  /* Anton condensada: "Parody" en una línea corta deja al descriptor en
     mono marcar el ancho del bloque, y el lockup completo cabe junto a la
     nav de seis ítems sin desbordar en el filo de los 920px */
  .mark__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 0.85;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .mark__descriptor {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    line-height: 1;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    /* Papel al 82% sobre el rojo son 4.6:1; a 9px hace falta el AA de 4.5:1
       largo, así que no baja de ahí */
    color: color-mix(in srgb, var(--paper) 82%, var(--rust));
  }

  /* ——— Botón hamburguesa (solo móvil) ——— */
  /* --line-strong es tinta translúcida: sobre el rojo daba un borde sucio.
     Papel al 55% se lee como filo claro sin pesar como un botón sólido */
  .header__toggle {
    display: none;
    align-items: center;
    gap: 0.6rem;
    background: none;
    border: 1px solid color-mix(in srgb, var(--paper) 55%, transparent);
    padding: 0.55rem 0.8rem;
    cursor: pointer;
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .header__toggle:active {
    transform: scale(0.96);
  }

  /* Ambos íconos ocupan la misma celda de grid y se cruzan en opacidad;
     evita el salto de layout que daría alternar display */
  .header__toggle-icon {
    display: grid;
    width: 18px;
    height: 18px;
  }

  /* Mismo truco que el logo: los dos SVG son de contorno negro y sobre el
     rojo casi no se veían; así quedan como siluetas blancas plenas */
  .header__toggle-icon img {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    filter: brightness(0) invert(1);
    transition: opacity 150ms ease, transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .header__toggle-close {
    opacity: 0;
    transform: rotate(-45deg) scale(0.7);
  }

  .is-open .header__toggle-open {
    opacity: 0;
    transform: rotate(45deg) scale(0.7);
  }

  .is-open .header__toggle-close {
    opacity: 1;
    transform: none;
  }

  .header__toggle-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper);
  }

  /* ——— Navegación ——— */
  .header__nav > ul {
    display: flex;
    gap: clamp(0.9rem, 2vw, 2rem);
  }

  nav a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--paper);
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  /* El hover ya no puede cambiar de color: papel es el único tono que pasa
     contraste sobre el rojo, así que la señal es el subrayado */
  nav a:hover {
    border-color: var(--paper);
  }

  /* ——— Dropdown de escritorio ——— */

  .nav__item {
    position: relative;
  }

  .nav__item-row {
    display: flex;
    align-items: center;
  }

  /* El link crece para llenar el ancho disponible en el panel móvil
     (tap target de fila completa); en la barra horizontal de escritorio
     no hay espacio libre que ceder, así que no cambia nada visualmente */
  .nav__item-row > a {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* Fila del selector de idioma: en escritorio la etiqueta está oculta y
     este flex no tiene nada que repartir; en móvil (ver media query) es lo
     que separa "Language" del switch a los dos extremos de la fila */
  .nav__item--lang {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav__lang-label {
    display: none;
  }

  .nav__caret-btn {
    display: inline-flex;
    align-items: center;
    flex: none;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    line-height: 1;
  }

  /* --steel sobre el rojo da 1.65:1 (invisible). Papel algo apagado lo
     mantiene por debajo de la etiqueta sin desaparecer */
  .nav__caret {
    display: inline-block;
    margin-left: 0.35em;
    font-size: 0.85em;
    color: var(--paper);
    opacity: 0.7;
    transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .nav__sub {
    display: block;
    position: absolute;
    top: calc(100% + 0.7rem);
    left: -1rem;
    min-width: 15rem;
    background: var(--paper);
    border: 2px solid var(--ink);
    box-shadow: 0.35rem 0.35rem 0 var(--ink);
    padding: 0.4rem 0;
    visibility: hidden;
    opacity: 0;
    transform: translateY(6px) scale(0.98);
    transform-origin: top left;
    transition:
      opacity 180ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 180ms cubic-bezier(0.23, 1, 0.32, 1),
      visibility 0s 180ms;
  }

  /* Puente invisible: el cursor no pierde el panel al cruzar el hueco */
  .nav__sub::before {
    content: '';
    position: absolute;
    top: -0.8rem;
    left: 0;
    right: 0;
    height: 0.8rem;
  }

  .nav__item--sub:hover .nav__sub,
  .nav__item--sub:focus-within .nav__sub {
    visibility: visible;
    opacity: 1;
    transform: translateY(0) scale(1);
    transition:
      opacity 180ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 180ms cubic-bezier(0.23, 1, 0.32, 1),
      visibility 0s;
  }

  .nav__item--sub:hover .nav__caret,
  .nav__item--sub:focus-within .nav__caret {
    transform: rotate(180deg);
  }

  .nav__sub li + li {
    border-top: 1px solid var(--line);
  }

  /* El color va explícito, no heredado: el panel es blanco pero `nav a` ya
     pinta en papel para la barra roja, y sin esto los enlaces del dropdown
     quedarían blanco sobre blanco */
  .nav__sub a {
    display: block;
    padding: 0.6rem 1rem;
    color: var(--ink-soft);
    border-bottom: none;
    white-space: nowrap;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .nav__sub a:hover {
    color: var(--enamel);
    background: var(--paper-dim);
    border-color: transparent;
  }

  /* El panel cuelga de la barra pero es blanco: el foco vuelve a la tinta,
     que en papel sí contrasta (el override en papel es solo para el rojo) */
  .nav__sub :focus-visible {
    outline-color: var(--enamel);
  }

  /* ——— Selector de idioma ——— */
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: 1px solid color-mix(in srgb, var(--paper) 55%, transparent);
    padding: 0.2rem;
  }

  /* Aparte de `nav a` a propósito: hereda familia/mayúsculas de mono pero
     no el subrayado de hover ni (en móvil) el tratamiento display grande
     de los enlaces de sección — es un control, no un link de navegación */
  .lang-switch__opt {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    padding: 0.25rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--paper);
    border-bottom: none;
  }

  a.lang-switch__opt:hover {
    border-color: transparent;
    background: color-mix(in srgb, var(--paper) 18%, transparent);
  }

  .lang-switch__opt.is-current {
    background: var(--paper);
    color: var(--ink);
    cursor: default;
  }

  /* ——— Panel desplegable en móvil ——— */
  @media (max-width: 920px) {
    .header__toggle {
      display: inline-flex;
    }

    /* Acá el panel entero es claro, así que ningún enlace queda sobre el
       rojo: el foco en papel sería invisible y vuelve a la tinta */
    .header__nav :focus-visible {
      outline-color: var(--enamel);
    }

    .header__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--paper);
      border-bottom: 2px solid var(--ink);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 200ms cubic-bezier(0.23, 1, 0.32, 1),
        transform 200ms cubic-bezier(0.23, 1, 0.32, 1), visibility 0s 200ms;
    }

    .is-open .header__nav {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
      transition: opacity 200ms cubic-bezier(0.23, 1, 0.32, 1),
        transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    .header__nav > ul {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem var(--gutter) 1rem;
    }

    nav li + li {
      border-top: 1px solid var(--line);
    }

    nav a {
      display: block;
      font-family: var(--font-display);
      font-size: 1.4rem;
      letter-spacing: 0.02em;
      color: var(--ink);
      padding-block: 0.8rem;
      border-bottom: none;
    }

    nav a:hover {
      border-color: transparent;
    }

    /* El caret ya no se esconde: ahora es el indicador de abierto/cerrado
       del acordeón, igual que en escritorio pero disparado por click.
       Sigue en --paper del bloque de escritorio (papel sobre rojo); acá el
       panel es claro y ese mismo blanco quedaba invisible sobre --paper */
    .nav__caret-btn {
      padding: 0.8rem 0.2rem 0.8rem 0.9rem;
    }

    .nav__caret {
      color: var(--ink-soft);
      opacity: 1;
      font-size: 1rem;
    }

    /* El acordeón vive en el wrap, no en .nav__sub: el hijo directo lleva
       overflow:hidden + min-height:0 — si fueran el mismo elemento el
       grid no tendría nada que recortar mientras anima */
    .nav__sub-wrap {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 200ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    .nav__item--sub[data-open] .nav__sub-wrap {
      grid-template-rows: 1fr;
    }

    .nav__item--sub[data-open] .nav__caret {
      transform: rotate(180deg);
    }

    /* Sin padding propio a propósito: este es el elemento que el grid del
       wrap fuerza a 0 de alto mientras colapsa. Un padding-bottom acá no se
       puede recortar del todo (box-sizing:border-box no deja que el padding
       propio empuje la caja a menos que su propia suma), y quedaba un
       filete visible incluso cerrado. El aire de cierre va en el último
       hijo, que sí es contenido recortable */
    .nav__sub {
      overflow: hidden;
      min-height: 0;
      position: static;
      visibility: visible;
      opacity: 1;
      transform: none;
      min-width: 0;
      border: none;
      box-shadow: none;
      background: none;
      padding: 0;
      transition: none;
    }

    .nav__sub li:last-child {
      padding-bottom: 0.6rem;
    }

    .nav__sub::before {
      display: none;
    }

    .nav__sub li + li {
      border-top: none;
    }

    .nav__sub a {
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      letter-spacing: 0.08em;
      color: var(--ink-soft);
      padding: 0.45rem 0 0.45rem 1.1rem;
      border-left: 2px solid var(--line-strong);
      margin-left: 0.2rem;
    }

    .nav__sub a:hover {
      background: none;
    }

    .nav__item--lang {
      padding-block: 0.9rem;
    }

    /* Acá sí se muestra: en el panel angosto el switch solo no explica qué
       controla, y "LANGUAGE"/"IDIOMA" es la misma etiqueta mono que ya usan
       los rótulos de spec del resto del sitio (plate__speclabel, etc.) */
    .nav__lang-label {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-soft);
    }

    .lang-switch {
      border-color: var(--line-strong);
    }

    .lang-switch__opt {
      color: var(--ink-soft);
    }

    a.lang-switch__opt:hover {
      background: var(--paper-dim);
    }

    .lang-switch__opt.is-current {
      background: var(--ink);
      color: var(--paper);
    }
  }

  /* En teléfonos angostos el lockup y el botón Menu llegan justos al ancho
     útil (~320px en un viewport de 360). Se aprieta el tracking del
     descriptor, que es lo que marca el ancho del bloque, antes que partirlo
     en dos líneas o esconderlo */
  @media (max-width: 420px) {
    .header__row {
      gap: 0.9rem;
    }

    .mark {
